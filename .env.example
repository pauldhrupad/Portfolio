# Public canonical URL used by metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://portfolio.example.com

# Server-only contact delivery settings. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=your_resend_api_key
CONTACT_FROM_EMAIL=Portfolio <contact@portfolio.example.com>
CONTACT_TO_EMAIL=you@example.com
